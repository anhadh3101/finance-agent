# Server secrets — copy to .env and fill in at the hackathon booth
HOTDATA_API_KEY=
# Optional: pin a hotdata database. Left blank, the app finds or creates one by name.
HOTDATA_WORKSPACE_ID=
HOTDATA_DATABASE_ID=
HOTDATA_DATABASE_NAME=finance-agent
# Fallback only: run the spend queries in local DuckDB until the hotdata key arrives.
# Every run reports which engine it used, so this is never silent.
ALLOW_LOCAL_QUERY_FALLBACK=false

HYDRADB_KEY=
HYDRADB_DATABASE=default-tenant
HYDRADB_URL=
HYDRADB_CREDENTIALS=

LLM_API_KEY=
ENABLE_BACKEND_ACCESS_CONTROL=false
AGENT_SHARED_SECRET=

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Sheet append for /adddemo — use ONE of these:
# Option A: Google service account JSON (share the sheet with its client_email as Editor)
GOOGLE_SERVICE_ACCOUNT_FILE=google-service-account.json
# Option B: Google Apps Script web app URL (see backend/google_apps_script_append.js)
GOOGLE_SHEET_APPEND_WEBHOOK=
GOOGLE_SHEET_APPEND_SECRET=

# Claude Code runs the agent workflow. Override if `claude` is not on PATH.
CLAUDE_BIN=claude
CLAUDE_TIMEOUT_SECONDS=240
